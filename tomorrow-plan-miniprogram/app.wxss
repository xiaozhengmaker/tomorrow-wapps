/* 全局：Sugar 那种贴纸拼贴感 —— 纯白面、高饱和色块、胶囊按钮、硬阴影 */

page {
  background-color: #f4f4f1;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    Helvetica, "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* 点阵底，像贴纸画布 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx 120rpx;
  background-color: #f4f4f1;
  background-image: radial-gradient(#dededa 1.5rpx, transparent 1.5rpx);
  background-size: 36rpx 36rpx;
}

.card {
  position: relative;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #e4e4df;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 0 #ecece7, 0 12rpx 26rpx rgba(17, 17, 17, 0.05);
}

/* ---------- 按钮：彩色贴纸胶囊 ---------- */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 96rpx;
  border-radius: 999rpx;
  background: #1e7bf5;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 0 #0b4fa8, 0 14rpx 24rpx rgba(30, 123, 245, 0.22);
}

.btn-primary:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 #0b4fa8, 0 8rpx 16rpx rgba(30, 123, 245, 0.2);
}

.btn-primary.is-disabled {
  background: #d9d9d4;
  color: #ffffff;
  box-shadow: 0 8rpx 0 #c9c9c4;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e4e4df;
  background: #ffffff;
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 0 #e8e8e3;
}

.btn-ghost:active {
  transform: translateY(5rpx);
  box-shadow: 0 1rpx 0 #e8e8e3;
  background: #fafaf8;
}

.btn-ghost-quiet {
  color: #8f8f8f;
  border-color: #ecece7;
  box-shadow: 0 6rpx 0 #f0f0ec;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  border: 2rpx solid #f0c9c2;
  background: #fff1ec;
  color: #d9301a;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 0 #f6dbd5;
}

.btn-danger:active {
  transform: translateY(5rpx);
  box-shadow: 0 1rpx 0 #f6dbd5;
}

.btn-flex {
  flex: 1;
}

/* ---------- 标签：小贴纸 ---------- */

.chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e4e4df;
  background: #ffffff;
  color: #3d3d3d;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 0 #ecece7;
}

.chip:active {
  transform: translateY(3rpx);
  box-shadow: 0 1rpx 0 #ecece7;
}

.tag {
  display: inline-block;
  padding: 5rpx 18rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.5;
}

.tag-work {
  background: #e4efff;
  color: #1e7bf5;
}

.tag-life {
  background: #fff3d6;
  color: #b27a00;
}

.tag-health {
  background: #e4f8e6;
  color: #12921c;
}

.tag-study {
  background: #efebff;
  color: #5a3ff0;
}

.tag-misc {
  background: #f1f1ee;
  color: #6e6e6e;
}

.tag-important {
  background: #ffe9e4;
  color: #d9301a;
}

.tag-auto {
  background: #f1f1ee;
  color: #9a9a9a;
}

/* ---------- 小号按钮（放最后，覆盖上面的高度） ---------- */

.btn-sm {
  height: 66rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
  border-radius: 999rpx;
  letter-spacing: 0;
  box-shadow: 0 5rpx 0 #0b4fa8;
}

/* ---------- 装饰：彩色贴纸点 ---------- */

.sticker-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #d6f73b;
  border: 3rpx solid #111111;
}

.sticker-square {
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: #e8351c;
  border: 3rpx solid #111111;
  transform: rotate(-12deg);
}

.sticker-pop {
  animation: pop 3.6s ease-in-out infinite;
}

@keyframes pop {
  0%, 100% { transform: translateY(0) rotate(-8deg); }
  50% { transform: translateY(-8rpx) rotate(4deg); }
}

.dot-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 30rpx;
}

.dot-row .sticker-dot,
.dot-row .sticker-square {
  margin: 0 7rpx;
}

/* ---------- 日期选择（首页 / 拆解页共用） ---------- */

.date-row {
  display: flex;
  align-items: flex-start;
  padding: 0 6rpx 14rpx;
}

.date-label {
  flex: none;
  font-size: 24rpx;
  color: #8f8f8f;
  font-weight: 600;
  margin-right: 14rpx;
  padding-top: 12rpx;
}

.date-chips {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.date-chip {
  padding: 10rpx 28rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid #e4e4df;
  background: #ffffff;
  color: #3d3d3d;
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 0 #ecece7;
}

.date-chip.is-on {
  background: #1e7bf5;
  border-color: #1e7bf5;
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 4rpx 0 #0b4fa8;
}
