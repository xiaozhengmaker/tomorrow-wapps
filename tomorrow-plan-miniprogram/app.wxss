/* 全局：Duolingo 那种塑料积木质感 —— 白卡 + 4rpx 硬边框 + 纯色厚边按钮 + 高饱和图标 */

page {
  background-color: #ffffff;
  color: #4b4b4b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    Helvetica, "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 120rpx;
  background-color: #ffffff;
}

/* 卡片：白面 + 4rpx 灰硬边，没有投影 */
.card {
  position: relative;
  box-sizing: border-box;
  background: #ffffff;
  border: 4rpx solid #e5e5e5;
  border-radius: 28rpx;
}

/* ---------- 按钮：底部一条实心厚边，按下去整体下沉 ---------- */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 100rpx;
  border-radius: 28rpx;
  background: #1cb0f6;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  box-shadow: 0 10rpx 0 #1899d6;
  transition: transform .1s ease-out, box-shadow .1s ease-out;
}

.btn-primary:active {
  transform: translateY(10rpx);
  box-shadow: 0 0 0 #1899d6;
}

.btn-primary.is-disabled {
  background: #e5e5e5;
  color: #afafaf;
  box-shadow: 0 10rpx 0 #d0d0d0;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 28rpx;
  border: 4rpx solid #e5e5e5;
  background: #ffffff;
  color: #1cb0f6;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 0 #e5e5e5;
  transition: transform .1s ease-out, box-shadow .1s ease-out;
}

.btn-ghost:active {
  transform: translateY(8rpx);
  box-shadow: 0 0 0 #e5e5e5;
  background: #f7f7f7;
}

.btn-ghost-quiet {
  color: #afafaf;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 40rpx;
  border-radius: 28rpx;
  background: #ff4b4b;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 0 #ea2b2b;
  transition: transform .1s ease-out, box-shadow .1s ease-out;
}

.btn-danger:active {
  transform: translateY(8rpx);
  box-shadow: 0 0 0 #ea2b2b;
}

.btn-flex {
  flex: 1;
}

/* ---------- 标签 ---------- */

.chip {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  border: 4rpx solid #e5e5e5;
  background: #ffffff;
  color: #4b4b4b;
  font-size: 24rpx;
  font-weight: 700;
  transition: transform .1s ease-out;
}

.chip:active {
  transform: translateY(2rpx);
  background: #f7f7f7;
}

.tag {
  display: inline-block;
  padding: 5rpx 18rpx;
  margin-right: 10rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.5;
}

.tag-work { background: #e3f4fd; color: #1899d6; }
.tag-life { background: #fff4d1; color: #b98a00; }
.tag-health { background: #e8f8d8; color: #58a700; }
.tag-study { background: #f3e6ff; color: #a568cc; }
.tag-misc { background: #f0f0f0; color: #8a8a8a; }
.tag-important { background: #ffe0e0; color: #ea2b2b; }
.tag-auto { background: #f0f0f0; color: #afafaf; }

/* ---------- 分类图标方块 ---------- */

.row-icon {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.icon-work { background: #1cb0f6; }
.icon-life { background: #ffc800; }
.icon-health { background: #58cc02; }
.icon-study { background: #ce82ff; }
.icon-misc { background: #afafaf; }

/* ---------- 小号按钮 ---------- */

.btn-sm {
  height: 76rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
  border-radius: 22rpx;
  letter-spacing: 0;
  box-shadow: 0 6rpx 0 #1899d6;
}

.btn-sm:active {
  transform: translateY(6rpx);
  box-shadow: 0 0 0 #1899d6;
}

/* ---------- 粗进度条 ---------- */

.progress-track {
  height: 28rpx;
  border-radius: 14rpx;
  background: #e5e5e5;
  overflow: hidden;
}

.progress-fill {
  position: relative;
  height: 100%;
  border-radius: 14rpx;
  background: #58cc02;
  transition: width .35s cubic-bezier(.2, .8, .3, 1);
}

.progress-fill::after {
  content: '';
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 5rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.42);
}

/* ---------- 动效 ---------- */

@keyframes pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.18); }
  70% { transform: scale(0.94); }
  100% { transform: scale(1); }
}

@keyframes rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes cheer {
  0% { opacity: 0; transform: scale(0.7) rotate(-4deg); }
  60% { transform: scale(1.06) rotate(2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}

.pop { animation: pop .36s cubic-bezier(.2, .8, .3, 1); }
.cheer { animation: cheer .42s cubic-bezier(.2, .8, .3, 1) both; }

.stagger > view {
  animation: rise .32s cubic-bezier(.2, .8, .3, 1) both;
}

.stagger > view:nth-child(1) { animation-delay: .02s; }
.stagger > view:nth-child(2) { animation-delay: .05s; }
.stagger > view:nth-child(3) { animation-delay: .08s; }
.stagger > view:nth-child(4) { animation-delay: .11s; }
.stagger > view:nth-child(5) { animation-delay: .14s; }
.stagger > view:nth-child(6) { animation-delay: .17s; }
.stagger > view:nth-child(7) { animation-delay: .20s; }
.stagger > view:nth-child(8) { animation-delay: .23s; }

/* ---------- 连续天数徽章 ---------- */

.streak {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx 0 12rpx;
  border-radius: 999rpx;
  background: #fff4d1;
  color: #b98a00;
  font-size: 24rpx;
  font-weight: 800;
}

.streak .flame {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  border-radius: 50% 50% 50% 8rpx;
  background: #ffc800;
  transform: rotate(-12deg);
}

.streak .num {
  font-size: 30rpx;
  margin: 0 4rpx;
}

/* ---------- 日期选择 ---------- */

.date-row {
  display: flex;
  align-items: flex-start;
  padding: 0 0 16rpx;
}

.date-label {
  flex: none;
  font-size: 24rpx;
  color: #afafaf;
  font-weight: 800;
  margin-right: 14rpx;
  padding-top: 12rpx;
}

.date-chips {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.date-chip {
  padding: 10rpx 28rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 20rpx;
  border: 4rpx solid #e5e5e5;
  background: #ffffff;
  color: #4b4b4b;
  font-size: 25rpx;
  font-weight: 800;
  transition: transform .1s ease-out;
}

.date-chip:active {
  transform: translateY(2rpx);
}

.date-chip.is-on {
  background: #1cb0f6;
  border-color: #1899d6;
  color: #ffffff;
  box-shadow: 0 4rpx 0 #1899d6;
}

