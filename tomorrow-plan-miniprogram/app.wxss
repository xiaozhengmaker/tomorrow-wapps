/* 全局：Joi 那种极简规划器 —— 纯白、无阴影、淡彩胶囊、超粗字、虚线分隔 */

page {
  background-color: #ffffff;
  color: #0a0a0a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    Helvetica, "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 40rpx 120rpx;
  background-color: #ffffff;
}

/* 卡片是「一层极淡的边界」，不用阴影 —— Joi 里几乎没有投影 */
.card {
  position: relative;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #f2f2f7;
  border-radius: 24rpx;
}

/* ---------- 按钮：平色胶囊，没有厚度 ---------- */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 100rpx;
  border-radius: 999rpx;
  background: #0a84ff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  transition: transform .16s cubic-bezier(.2,.8,.3,1), opacity .16s;
}

.btn-primary:active {
  transform: scale(0.972);
  opacity: 0.92;
}

.btn-primary.is-disabled {
  background: #e5e5ea;
  color: #aeaeb2;
  transform: none;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform .16s cubic-bezier(.2,.8,.3,1), background .16s;
}

.btn-ghost:active {
  transform: scale(0.972);
  background: #e8e8ed;
}

.btn-ghost-quiet {
  background: #ffffff;
  color: #8e8e93;
  border: 2rpx solid #f2f2f7;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: #ffede6;
  color: #ff3b30;
  font-size: 29rpx;
  font-weight: 700;
  transition: transform .16s cubic-bezier(.2,.8,.3,1);
}

.btn-danger:active {
  transform: scale(0.972);
}

.btn-flex {
  flex: 1;
}

/* ---------- 标签：淡彩胶囊，无描边 ---------- */

.chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #3a3a3c;
  font-size: 24rpx;
  font-weight: 600;
  transition: transform .16s cubic-bezier(.2,.8,.3,1);
}

.chip:active {
  transform: scale(0.96);
}

.tag {
  display: inline-block;
  padding: 5rpx 18rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.5;
}

.tag-work {
  background: #e5f3ff;
  color: #0a84ff;
}

.tag-life {
  background: #fff5d6;
  color: #c77700;
}

.tag-health {
  background: #e7f9ec;
  color: #34c759;
}

.tag-study {
  background: #eeeaff;
  color: #5e5ce6;
}

.tag-misc {
  background: #f2f2f7;
  color: #8e8e93;
}

.tag-important {
  background: #ffede6;
  color: #ff5f2e;
}

.tag-auto {
  background: #f2f2f7;
  color: #aeaeb2;
}

/* ---------- 小号按钮（放最后，覆盖上面的高度） ---------- */

.btn-sm {
  height: 68rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
  border-radius: 999rpx;
  letter-spacing: 0;
}

/* ---------- 动效：入场依次升起 ---------- */

@keyframes rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes popIn {
  0% { opacity: 0; transform: scale(0.9); }
  70% { transform: scale(1.03); }
  100% { opacity: 1; transform: scale(1); }
}

.stagger > view {
  animation: rise 0.36s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.stagger > view:nth-child(1) { animation-delay: 0.02s; }
.stagger > view:nth-child(2) { animation-delay: 0.06s; }
.stagger > view:nth-child(3) { animation-delay: 0.10s; }
.stagger > view:nth-child(4) { animation-delay: 0.14s; }
.stagger > view:nth-child(5) { animation-delay: 0.18s; }
.stagger > view:nth-child(6) { animation-delay: 0.22s; }
.stagger > view:nth-child(7) { animation-delay: 0.26s; }
.stagger > view:nth-child(8) { animation-delay: 0.30s; }

.pop-in {
  animation: popIn 0.34s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

/* ---------- 虚线分隔（Joi 列表的签名） ---------- */

.dash {
  border-bottom: 2rpx dashed #ececf1;
}

/* ---------- 日期选择（首页 / 拆解页共用） ---------- */

.date-row {
  display: flex;
  align-items: flex-start;
  padding: 0 0 16rpx;
}

.date-label {
  flex: none;
  font-size: 24rpx;
  color: #8e8e93;
  font-weight: 600;
  margin-right: 14rpx;
  padding-top: 12rpx;
}

.date-chips {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.date-chip {
  padding: 10rpx 28rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #3a3a3c;
  font-size: 25rpx;
  font-weight: 600;
  transition: transform .16s cubic-bezier(.2,.8,.3,1), background .18s, color .18s;
}

.date-chip:active {
  transform: scale(0.95);
}

.date-chip.is-on {
  background: #0a84ff;
  color: #ffffff;
  font-weight: 800;
}
