.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 140rpx;
  background: #f7f7f5;
}

/* ---------- 台历外形 ---------- */

.desk {
  position: relative;
  background: #ffffff;
  border: 4rpx solid #dcdcdc;
  border-radius: 10rpx;
  /* 硬偏移阴影 = 它立在桌面上 */
  box-shadow: 0 12rpx 0 #e6e6e6, 0 24rpx 40rpx rgba(0, 0, 0, 0.10);
  overflow: hidden;
}

/* 螺旋装订 */
.binding {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 26rpx 0;
  background: #ffffff;
}

.ring {
  position: relative;
  width: 20rpx;
  height: 34rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #9a9a9a 0%, #5a5a5a 45%, #3a3a3a 100%);
  border: 2rpx solid #2a2a2a;
}

.ring-hole {
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

/* 像素花园 */
.cal-banner {
  display: block;
  width: 100%;
  height: 132rpx;
  margin-top: -6rpx;
}

.cal-body {
  padding: 20rpx 20rpx 26rpx;
}

/* ---------- 月份切换 ---------- */

.cal-head {
  display: flex;
  align-items: center;
  padding: 4rpx 0 22rpx;
}

.cal-nav {
  width: 68rpx;
  height: 68rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #0a0a0a;
  border: 4rpx solid #dcdcdc;
  border-radius: 8rpx;
  box-shadow: 0 5rpx 0 #dcdcdc;
  background: #ffffff;
}

.cal-nav:active {
  transform: translateY(5rpx);
  box-shadow: 0 0 0 #dcdcdc;
}

.cal-title {
  flex: 1;
  text-align: center;
}

.cal-month {
  font-size: 32rpx;
  font-weight: 800;
  color: #0a0a0a;
  letter-spacing: -0.5rpx;
}

.cal-summary {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9a9a9a;
  font-weight: 600;
}

/* ---------- 星期与日期 ---------- */

.cal-week {
  display: flex;
  padding-bottom: 8rpx;
  border-bottom: 4rpx solid #f0f0f0;
}

.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #9a9a9a;
  font-weight: 700;
}

.cal-week-cell.is-weekend {
  color: #e02a1a;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 10rpx;
}

.cal-cell {
  width: 14.28%;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 8rpx;
  box-sizing: border-box;
  position: relative;
}

.cal-cell.is-blank {
  opacity: 0;
}

.cal-day {
  font-size: 24rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.1;
}

.cal-cell.is-weekend .cal-day {
  color: #e02a1a;
}

/* 今天：数字下面加一条橙色短线 */
.cal-cell.is-today .cal-day {
  color: #ff6b1a;
}

.cal-cell.is-today::after {
  content: '';
  position: absolute;
  top: 34rpx;
  left: 50%;
  margin-left: -14rpx;
  width: 28rpx;
  height: 3rpx;
  background: #ff6b1a;
}

/* 进度火焰 */
.cal-flame {
  width: 32rpx;
  height: 34rpx;
  margin-top: 8rpx;
  image-rendering: pixelated;
}

.cal-flame-holder {
  width: 32rpx;
  height: 34rpx;
  margin-top: 8rpx;
}

/* ---------- 台历底座 ---------- */

.desk-base {
  height: 16rpx;
  background: linear-gradient(180deg, #f4f4f4 0%, #e0e0e0 100%);
  border-top: 4rpx solid #dcdcdc;
}

/* ---------- 图例 ---------- */

.cal-legend {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  padding-top: 44rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 12rpx 14rpx;
  font-size: 20rpx;
  color: #9a9a9a;
  font-weight: 600;
}

.legend-flame {
  width: 22rpx;
  height: 24rpx;
  margin-right: 6rpx;
  image-rendering: pixelated;
}
