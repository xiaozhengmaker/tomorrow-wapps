.hero {
  padding: 6rpx 6rpx 36rpx;
}

.hero-eyebrow {
  font-size: 21rpx;
  letter-spacing: 8rpx;
  color: #c2c2c2;
  padding-left: 4rpx;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.26;
  letter-spacing: 1rpx;
  color: #0e0e0e;
}

.hero-title-2 {
  color: #1e7bf5;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #808080;
  line-height: 1.6;
  max-width: 560rpx;
}

/* ---------- 已有的清单卡片 ---------- */

.plan-card {
  padding: 24rpx 26rpx 18rpx;
  margin-bottom: 22rpx;
}

.plan-card:active {
  background: #fbfbf9;
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-head-left {
  display: flex;
  align-items: center;
}

.plan-badge {
  font-size: 23rpx;
  font-weight: 600;
  color: #1e7bf5;
  background: #e6f0ff;
  padding: 3rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.plan-weekday {
  font-size: 24rpx;
  color: #8f8f8f;
}

.plan-ratio {
  font-size: 24rpx;
  color: #8f8f8f;
  letter-spacing: 1rpx;
}

.plan-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #efefea;
  margin: 18rpx 0 6rpx;
  overflow: hidden;
}

.plan-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #3d93ff, #0b5fd0);
  transition: width 0.3s ease;
}

.mini-row {
  display: flex;
  align-items: center;
  padding: 11rpx 0;
  border-bottom: 1rpx dashed #e8e8e3;
}

.mini-time {
  flex: none;
  width: 92rpx;
  font-size: 24rpx;
  color: #9e9e9e;
}

.mini-title {
  flex: 1;
  font-size: 27rpx;
  color: #2b2b2b;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mini-done {
  color: #c9c9c9;
  text-decoration: line-through;
}

.plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.plan-more {
  font-size: 23rpx;
  color: #bdbdbd;
}

.plan-link {
  font-size: 23rpx;
  color: #1e7bf5;
}

/* ---------- 复盘提醒 ---------- */

.nudge {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  margin-bottom: 22rpx;
  background: #fff8ec;
  border-color: #efefe9;
}

.nudge-main {
  flex: 1;
}

.nudge-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8a6a1f;
}

.nudge-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8a8a8a;
}

.nudge-arrow {
  flex: none;
  font-size: 34rpx;
  color: #cfcfca;
}

/* ---------- 输入区 ---------- */
.input-card {
  padding: 26rpx 26rpx 20rpx;
  margin-bottom: 24rpx;
}

.input-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.input-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.input-hint {
  font-size: 22rpx;
  color: #9e9e9e;
}

.input-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 220rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f2f2ef;
  font-size: 29rpx;
  line-height: 1.72;
  color: #1a1a1a;
}

.input-ph {
  color: #cfcfcf;
  line-height: 1.72;
}

.input-tools {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.chip-gap {
  margin-left: 14rpx;
}

.input-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #d8d8d8;
}

/* ---------- 底部说明 ---------- */

.tips {
  margin-top: 44rpx;
  padding: 0 6rpx;
}

.tips-title {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #c2c2c2;
  margin-bottom: 14rpx;
}

.tips-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9rpx 0;
  font-size: 24rpx;
}

.tips-k {
  color: #808080;
}

.tips-v {
  color: #b5b5b5;
}
