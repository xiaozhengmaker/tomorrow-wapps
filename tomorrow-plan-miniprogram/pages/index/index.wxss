.hero {
  padding: 6rpx 6rpx 36rpx;
}

.hero-eyebrow {
  font-size: 21rpx;
  letter-spacing: 8rpx;
  color: #c7c7cc;
  padding-left: 4rpx;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.26;
  letter-spacing: 1rpx;
  color: #0a0a0a;
}

.hero-title-2 {
  color: #0a84ff;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.6;
  max-width: 560rpx;
}

/* ---------- 已有的清单卡片 ---------- */

.plan-card {
  padding: 24rpx 26rpx 18rpx;
  margin-bottom: 22rpx;
}

.plan-card:active {
  background: #fbfbfb;
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-head-left {
  display: flex;
  align-items: center;
}

.plan-badge {
  font-size: 23rpx;
  font-weight: 600;
  color: #0a84ff;
  background: #e5f3ff;
  padding: 3rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.plan-weekday {
  font-size: 24rpx;
  color: #8e8e93;
}

.plan-ratio {
  font-size: 24rpx;
  color: #8e8e93;
  letter-spacing: 1rpx;
}

.plan-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #f2f2f7;
  margin: 18rpx 0 6rpx;
  overflow: hidden;
}

.plan-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #3395ff, #0060df);
  transition: width 0.3s ease;
}

.mini-row {
  display: flex;
  align-items: center;
  padding: 11rpx 0;
  border-bottom: 1rpx dashed #ebebf0;
}

.mini-time {
  flex: none;
  width: 92rpx;
  font-size: 24rpx;
  color: #aeaeb2;
}

.mini-title {
  flex: 1;
  font-size: 27rpx;
  color: #1c1c1e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mini-done {
  color: #c7c7cc;
  text-decoration: line-through;
}

.plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.plan-more {
  font-size: 23rpx;
  color: #c7c7cc;
}

.plan-link {
  font-size: 23rpx;
  color: #0a84ff;
}

/* ---------- 复盘提醒 ---------- */

.nudge {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  margin-bottom: 22rpx;
  background: #fff8e6;
  border-color: #f2f2f7;
}

.nudge-main {
  flex: 1;
}

.nudge-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #b25000;
}

.nudge-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8e8e93;
}

.nudge-arrow {
  flex: none;
  font-size: 34rpx;
  color: #d1d1d6;
}

/* ---------- 输入区 ---------- */
.input-card {
  padding: 26rpx 26rpx 20rpx;
  margin-bottom: 24rpx;
}

.input-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.input-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.input-hint {
  font-size: 22rpx;
  color: #aeaeb2;
}

.input-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 220rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  font-size: 29rpx;
  line-height: 1.72;
  color: #111111;
}

.input-ph {
  color: #d1d1d6;
  line-height: 1.72;
}

.input-tools {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.chip-gap {
  margin-left: 14rpx;
}

.input-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #d8d8dd;
}

/* ---------- 底部说明 ---------- */

.tips {
  margin-top: 44rpx;
  padding: 0 6rpx;
}

.tips-title {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #c7c7cc;
  margin-bottom: 14rpx;
}

.tips-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9rpx 0;
  font-size: 24rpx;
}

.tips-k {
  color: #8e8e93;
}

.tips-v {
  color: #c0c0c5;
}

/* 卡片加一层彩色描边，别让白卡飘在白底上 */
.plan-card.card-tint-blue {
  border-color: #dcecff;
  box-shadow: 0 10rpx 30rpx rgba(10, 132, 255, 0.07);
}

.input-card {
  border-color: #f0f0f5;
  box-shadow: 0 8rpx 24rpx rgba(17, 17, 17, 0.04);
}

.tips-title {
  color: #0a84ff;
}