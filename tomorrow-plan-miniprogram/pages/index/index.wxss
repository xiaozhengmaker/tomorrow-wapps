.hero {
  padding: 6rpx 6rpx 36rpx;
}

.hero-eyebrow {
  font-size: 21rpx;
  letter-spacing: 8rpx;
  color: #c7c7cc;
  padding-left: 4rpx;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.26;
  letter-spacing: 1rpx;
  color: #0a0a0a;
}

.hero-title-2 {
  color: #0a84ff;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.6;
  max-width: 560rpx;
}

/* ---------- 已有的清单卡片 ---------- */

.plan-card {
  padding: 24rpx 26rpx 18rpx;
  margin-bottom: 22rpx;
}

.plan-card:active {
  background: #fbfbfb;
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-head-left {
  display: flex;
  align-items: center;
}

.plan-badge {
  font-size: 23rpx;
  font-weight: 600;
  color: #0a84ff;
  background: #e5f3ff;
  padding: 3rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.plan-weekday {
  font-size: 24rpx;
  color: #8e8e93;
}

.plan-ratio {
  font-size: 24rpx;
  color: #8e8e93;
  letter-spacing: 1rpx;
}

.plan-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #f2f2f7;
  margin: 18rpx 0 6rpx;
  overflow: hidden;
}

.plan-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #3395ff, #0060df);
  transition: width 0.3s ease;
}

.mini-row {
  display: flex;
  align-items: center;
  padding: 11rpx 0;
  border-bottom: 1rpx dashed #ebebf0;
}

.mini-time {
  flex: none;
  width: 92rpx;
  font-size: 24rpx;
  color: #aeaeb2;
}

.mini-title {
  flex: 1;
  font-size: 27rpx;
  color: #1c1c1e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mini-done {
  color: #c7c7cc;
  text-decoration: line-through;
}

.plan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.plan-more {
  font-size: 23rpx;
  color: #c7c7cc;
}

.plan-link {
  font-size: 23rpx;
  color: #0a84ff;
}

/* ---------- 复盘提醒 ---------- */

.nudge {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  margin-bottom: 22rpx;
  background: #fff8e6;
  border-color: #f2f2f7;
}

.nudge-main {
  flex: 1;
}

.nudge-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #b25000;
}

.nudge-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8e8e93;
}

.nudge-arrow {
  flex: none;
  font-size: 34rpx;
  color: #c9c9c9;
}

/* ---------- 输入区 ---------- */
.input-card {
  padding: 26rpx 26rpx 20rpx;
  margin-bottom: 24rpx;
}

.input-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.input-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.input-hint {
  font-size: 22rpx;
  color: #aeaeb2;
}

.input-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 220rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  font-size: 29rpx;
  line-height: 1.72;
  color: #111111;
}

.input-ph {
  color: #c9c9c9;
  line-height: 1.72;
}

.input-tools {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.chip-gap {
  margin-left: 14rpx;
}

.input-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #d8d8dd;
}

/* ---------- 底部说明 ---------- */

.tips {
  margin-top: 44rpx;
  padding: 0 6rpx;
}

.tips-title {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #c7c7cc;
  margin-bottom: 14rpx;
}

.tips-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9rpx 0;
  font-size: 24rpx;
}

.tips-k {
  color: #8e8e93;
}

.tips-v {
  color: #c0c0c5;
}

/* 卡片加一层彩色描边，别让白卡飘在白底上 */
.plan-card.card-tint-blue {
  border-color: #dcecff;
  box-shadow: 0 10rpx 30rpx rgba(10, 132, 255, 0.07);
}

.input-card {
  border-color: #f0f0f5;
  box-shadow: 0 8rpx 24rpx rgba(17, 17, 17, 0.04);
}

.tips-title {
  color: #0a84ff;
}
/* 连续天数 */
.streak-wrap {
  padding: 6rpx 0 14rpx;
}
/* ================= 布局重构：顶栏压成一行 + 悬浮输入 ================= */

/* 顶栏：火焰脱离文档流，压在日期文字的左上方 */
.topbar {
  position: relative;
  padding: 18rpx 0 24rpx;
  min-height: 104rpx;
}

/* 顶部一条「游乐场」，火焰在这条带子里飘，不遮挡下面的清单 */
.mascot-playground {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 0;
  height: 300rpx;
  z-index: 3;
  pointer-events: none;
}

.topbar-mascot {
  position: absolute;
  left: 0;
  top: 0;
  width: 132rpx;
  height: 152rpx;
  pointer-events: auto;
  transform-origin: 0 0;
  /* 飘过去要有点回弹感 */
  transition: transform 1.4s cubic-bezier(0.34, 1.4, 0.64, 1);
  filter: drop-shadow(0 10rpx 14rpx rgba(255, 107, 26, 0.28))
          drop-shadow(0 3rpx 4rpx rgba(0, 0, 0, 0.16));
}

/* 闪现：不带动画地瞬移 */
.topbar-mascot.is-blink {
  transition: opacity 0.16s linear;
  opacity: 0;
}

.mascot-inner {
  width: 100%;
  height: 100%;
  transform: scale(0.62);
  transform-origin: 0 0;
}

.topbar-main {
  padding-left: 84rpx;
  min-width: 0;
}

.topbar-date {
  font-size: 38rpx;
  font-weight: 800;
  color: #0a0a0a;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.topbar-stat {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9a9a9a;
  font-weight: 600;
}

.empty-hint {
  padding: 60rpx 0 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0a0a0a;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.fab {
  position: fixed;
  left: 50%;
  bottom: 36rpx;
  transform: translateX(-50%);
  z-index: 50;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 0 #000000, 0 18rpx 30rpx rgba(0, 0, 0, 0.18);
}

.fab:active {
  transform: translateX(-50%) translateY(10rpx);
  box-shadow: 0 0 0 #000000;
}

.fab-plus {
  font-size: 38rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.composer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 10, 10, 0.28);
  z-index: 90;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx 32rpx 60rpx;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 4rpx solid #dcdcdc;
  animation: sheetUp 0.24s cubic-bezier(0.2, 0.8, 0.3, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.composer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
}

.composer-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0a0a0a;
}

.composer-close {
  font-size: 26rpx;
  color: #9a9a9a;
  font-weight: 700;
  padding: 8rpx 4rpx;
}

.composer .btn-primary {
  margin-top: 22rpx;
}

.nudge {
  border: 4rpx solid #ffe0c2;
  border-radius: 10rpx;
  background: #fff8f0;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}
