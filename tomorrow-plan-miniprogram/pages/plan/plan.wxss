/* ---------- 顶部 ---------- */

.head {
  padding: 10rpx 8rpx 34rpx;
}

.head-top {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #a0a0a0;
  letter-spacing: 1rpx;
}

.head-sep {
  margin: 0 10rpx;
  color: #c9c9c4;
}

.head-title {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #0e0e0e;
}

.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8f8f8f;
}

.bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #efefea;
  margin-top: 20rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #3d93ff, #0b5fd0);
  transition: width 0.3s ease;
}

/* ---------- 空状态 ---------- */

.empty {
  padding: 120rpx 40rpx 0;
  text-align: center;
}

.empty-mark {
  font-size: 76rpx;
  color: #dededa;
  line-height: 1;
}

.empty-title {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #3d3d3d;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #9e9e9e;
}

.empty-btn {
  margin: 48rpx auto 0;
  width: 380rpx;
}

/* ---------- 时间轴 ---------- */

.timeline {
  padding-top: 4rpx;
}

.row {
  display: flex;
  align-items: stretch;
}

.row-time {
  flex: none;
  width: 104rpx;
  padding-top: 24rpx;
  text-align: right;
}

.row-clock {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.row-dur {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #bdbdbd;
}

.row-rail {
  position: relative;
  flex: none;
  width: 46rpx;
}

.row-line {
  position: absolute;
  left: 50%;
  margin-left: -1rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #e6e6e1;
}

.row:first-child .row-line {
  top: 36rpx;
}

.row:last-child .row-line {
  bottom: auto;
  height: 36rpx;
}

.row:only-child .row-line {
  display: none;
}

.row-dot {
  position: absolute;
  left: 50%;
  margin-left: -10rpx;
  top: 30rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ffffff;
  border: 5rpx solid #d4d4ce;
  z-index: 2;
}

.row-body {
  flex: 1;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx 18rpx;
}

.row-body:active {
  background: #fbfbf9;
}

.row-main {
  display: flex;
  align-items: flex-start;
}

.row-title {
  flex: 1;
  font-size: 31rpx;
  line-height: 1.45;
  color: #1a1a1a;
  word-break: break-all;
  padding-right: 16rpx;
}

.row-check {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 2rpx solid #dededa;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-progress {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: #f0f0ec;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5a5a5a;
  word-break: break-all;
}

/* 进度判定出来的状态 */
.st-blocked { background: #ffe9e4; color: #d9301a; }
.st-almost { background: #e4f8e6; color: #12921c; }
.st-half { background: #e4efff; color: #1e7bf5; }
.st-started { background: #eef0f4; color: #6b7280; }
.st-notStarted { background: #f1f1ee; color: #808080; }
.st-finished { background: #e4f8e6; color: #12921c; }
.st-doing { background: #efebff; color: #5a3ff0; }

.row-check.is-checked {
  background: #1e7bf5;
  border-color: #1e7bf5;
}

.row-tick {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}

.row-tags {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.tag-late {
  background: #ffe9e4;
  color: #d9301a;
}

/* 已完成 / 已过点 */

.row-done .row-clock {
  color: #c9c9c9;
}

.row-done .row-title {
  color: #b8b8b8;
  text-decoration: line-through;
}

.row-done .row-dot {
  border-color: #8fb07a;
  background: #eaf4ec;
}

.row-done .row-body {
  background: #fafaf8;
  box-shadow: none;
}

.row-late .row-dot {
  border-color: #e0553a;
  background: #ffe9e4;
}

.row-late .row-clock {
  color: #5b8ff5;
}

.row-late .row-title {
  color: #333333;
}

/* ---------- 底部 ---------- */

.foot {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.foot-gap {
  margin-left: 16rpx;
}

.hint {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #cfcfcf;
}

/* ---------- 编辑弹层 ---------- */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(35, 29, 22, 0.42);
  animation: fadeIn 0.18s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  box-sizing: border-box;
  padding: 16rpx 32rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -14rpx 44rpx rgba(17, 17, 17, 0.16);
  animation: sheetUp 0.22s cubic-bezier(0.2, 0.8, 0.3, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-bar {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #dededa;
  margin: 0 auto 18rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e8e8e3;
}

.field-column {
  display: block;
}

.field-label {
  flex: none;
  width: 110rpx;
  font-size: 26rpx;
  color: #8f8f8f;
}

.field-label-top {
  display: block;
  width: auto;
  margin-bottom: 16rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
}

.field-ph {
  color: #d4d4d4;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e7bf5;
  letter-spacing: 1rpx;
}

.field-arrow {
  color: #d8d8d3;
  font-size: 32rpx;
}

.tag-picker {
  display: flex;
  flex-wrap: wrap;
}

.prog-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.prog-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dededa;
  background: #f2f2ef;
  font-size: 24rpx;
  color: #7d7263;
}

.prog-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f2f2ef;
  font-size: 27rpx;
  line-height: 1.6;
  color: #1a1a1a;
}

.tag-opt {
  margin: 0 14rpx 14rpx 0;
  padding: 12rpx 26rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dededa;
  background: #f2f2ef;
  font-size: 26rpx;
  color: #7d7263;
}

.tag-opt.is-active {
  background: #e6f0ff;
  border-color: #c9c9c4;
  color: #1e7bf5;
  font-weight: 600;
}

.sheet-actions {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}

.sheet-actions .btn-danger {
  margin-right: 18rpx;
}
