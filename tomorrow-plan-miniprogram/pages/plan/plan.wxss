/* ---------- 顶部 ---------- */

.head {
  padding: 10rpx 8rpx 34rpx;
}

.head-top {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #aeaeb2;
  letter-spacing: 1rpx;
}

.head-sep {
  margin: 0 10rpx;
  color: #d1d1d6;
}

.head-title {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #0a0a0a;
}

.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #f2f2f7;
  margin-top: 20rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #3395ff, #0060df);
  transition: width 0.3s ease;
}

/* ---------- 空状态 ---------- */

.empty {
  padding: 120rpx 40rpx 0;
  text-align: center;
}

.empty-mark {
  font-size: 76rpx;
  color: #e0e0e6;
  line-height: 1;
}

.empty-title {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #3a3a3c;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #aeaeb2;
}

.empty-btn {
  margin: 48rpx auto 0;
  width: 380rpx;
}

/* ---------- 时间轴 ---------- */

.timeline {
  padding-top: 4rpx;
}

.row {
  display: flex;
  align-items: stretch;
}

.row-time {
  flex: none;
  width: 104rpx;
  padding-top: 24rpx;
  text-align: right;
}

.row-clock {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #111111;
  letter-spacing: 0.5rpx;
}

.row-dur {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #c7c7cc;
}

.row-rail {
  position: relative;
  flex: none;
  width: 46rpx;
}

.row-line {
  position: absolute;
  left: 50%;
  margin-left: -1rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #ececf1;
}

.row:first-child .row-line {
  top: 36rpx;
}

.row:last-child .row-line {
  bottom: auto;
  height: 36rpx;
}

.row:only-child .row-line {
  display: none;
}

.row-dot {
  position: absolute;
  left: 50%;
  margin-left: -10rpx;
  top: 30rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ffffff;
  border: 5rpx solid #d1d1d6;
  z-index: 2;
}

.row-body {
  flex: 1;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx 18rpx;
}

.row-body:active {
  background: #fbfbfb;
}

.row-main {
  display: flex;
  align-items: flex-start;
}

.row-title {
  flex: 1;
  font-size: 31rpx;
  line-height: 1.45;
  color: #111111;
  word-break: break-all;
  padding-right: 16rpx;
}

.row-check {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 2rpx solid #e0e0e6;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-progress {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: #f5f5f7;
  font-size: 24rpx;
  line-height: 1.6;
  color: #636366;
  word-break: break-all;
}

/* 进度判定出来的状态 */
.st-blocked { background: #ffede6; color: #ff3b30; }
.st-almost { background: #e7f9ec; color: #34c759; }
.st-half { background: #e5f3ff; color: #0a84ff; }
.st-started { background: #f2f2f7; color: #8e8e93; }
.st-notStarted { background: #f2f2f7; color: #8e8e93; }
.st-finished { background: #e7f9ec; color: #34c759; }
.st-doing { background: #eeeaff; color: #5e5ce6; }

.row-check.is-checked {
  background: #0a84ff;
  border-color: #0a84ff;
}

.row-tick {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}

.row-tags {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.tag-late {
  background: #ffede6;
  color: #ff3b30;
}

/* 已完成 / 已过点 */

.row-done .row-clock {
  color: #c7c7cc;
}

.row-done .row-title {
  color: #c4c4c9;
  text-decoration: line-through;
}

.row-done .row-dot {
  border-color: #34c759;
  background: #edf9f0;
}

.row-done .row-body {
  background: #fafafa;
  box-shadow: none;
}

.row-late .row-dot {
  border-color: #ff5f2e;
  background: #ffede6;
}

.row-late .row-clock {
  color: #5aa5ff;
}

.row-late .row-title {
  color: #2c2c2e;
}

/* ---------- 底部 ---------- */

.foot {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.foot-gap {
  margin-left: 16rpx;
}

.hint {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #d1d1d6;
}

/* ---------- 编辑弹层 ---------- */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(35, 29, 22, 0.42);
  animation: fadeIn 0.18s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  box-sizing: border-box;
  padding: 16rpx 32rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -14rpx 44rpx rgba(17, 17, 17, 0.16);
  animation: sheetUp 0.22s cubic-bezier(0.2, 0.8, 0.3, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-bar {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e0e0e6;
  margin: 0 auto 18rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
  margin-bottom: 6rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ebebf0;
}

.field-column {
  display: block;
}

.field-label {
  flex: none;
  width: 110rpx;
  font-size: 26rpx;
  color: #8e8e93;
}

.field-label-top {
  display: block;
  width: auto;
  margin-bottom: 16rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #111111;
}

.field-ph {
  color: #d1d1d6;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #0a84ff;
  letter-spacing: 1rpx;
}

.field-arrow {
  color: #d8d8dd;
  font-size: 32rpx;
}

.tag-picker {
  display: flex;
  flex-wrap: wrap;
}

.prog-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.prog-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e0e0e6;
  background: #f2f2f7;
  font-size: 24rpx;
  color: #636366;
}

.prog-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
  font-size: 27rpx;
  line-height: 1.6;
  color: #111111;
}

.tag-opt {
  margin: 0 14rpx 14rpx 0;
  padding: 12rpx 26rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e0e0e6;
  background: #f2f2f7;
  font-size: 26rpx;
  color: #636366;
}

.tag-opt.is-active {
  background: #e5f3ff;
  border-color: #d1d1d6;
  color: #0a84ff;
  font-weight: 600;
}

.sheet-actions {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}

.sheet-actions .btn-danger {
  margin-right: 18rpx;
}

/* ================= Joi 化：平铺列表 + 虚线分隔 + 更粗的字 ================= */

.head-title {
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.head-top {
  font-size: 22rpx;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: 0.5rpx;
}

.row-body {
  background: transparent;
  border: 0;
  border-bottom: 2rpx dashed #ececf1;
  border-radius: 0;
  box-shadow: none;
  padding: 24rpx 0 22rpx;
}

.row:last-child .row-body {
  border-bottom: 0;
}

.row-body:active {
  background: #fafafa;
}

.row-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
}

.row-clock {
  font-size: 27rpx;
  font-weight: 800;
}

.row-dur {
  font-size: 19rpx;
  color: #aeaeb2;
}

.row-check {
  border: 2rpx solid #d1d1d6;
  background: #ffffff;
  transition: transform .16s cubic-bezier(.2,.8,.3,1), background .18s, border-color .18s;
}

.row-check:active {
  transform: scale(0.9);
}

.row-check.is-checked {
  background: #0a84ff;
  border-color: #0a84ff;
}

.row-progress {
  background: #f2f2f7;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.row-done .row-body {
  background: transparent;
  border-bottom: 2rpx dashed #ececf1;
}

.row-done .row-title {
  color: #aeaeb2;
}