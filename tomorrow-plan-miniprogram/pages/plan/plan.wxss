/* ---------- 顶部 ---------- */

.head {
  padding: 10rpx 8rpx 34rpx;
}

.head-top {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #93a088;
  letter-spacing: 1rpx;
}

.head-sep {
  margin: 0 10rpx;
  color: #bcc9a8;
}

.head-title {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #2b3a26;
}

.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8d9b82;
}

.bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #e3ebd4;
  margin-top: 20rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #86ab74, #5b7f4e);
  transition: width 0.3s ease;
}

/* ---------- 空状态 ---------- */

.empty {
  padding: 120rpx 40rpx 0;
  text-align: center;
}

.empty-mark {
  font-size: 76rpx;
  color: #c2cfae;
  line-height: 1;
}

.empty-title {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #4a5742;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #94a189;
}

.empty-btn {
  margin: 48rpx auto 0;
  width: 380rpx;
}

/* ---------- 时间轴 ---------- */

.timeline {
  padding-top: 4rpx;
}

.row {
  display: flex;
  align-items: stretch;
}

.row-time {
  flex: none;
  width: 104rpx;
  padding-top: 24rpx;
  text-align: right;
}

.row-clock {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #33422d;
  letter-spacing: 0.5rpx;
}

.row-dur {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #a5b39a;
}

.row-rail {
  position: relative;
  flex: none;
  width: 46rpx;
}

.row-line {
  position: absolute;
  left: 50%;
  margin-left: -1rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #dee7cf;
}

.row:first-child .row-line {
  top: 36rpx;
}

.row:last-child .row-line {
  bottom: auto;
  height: 36rpx;
}

.row:only-child .row-line {
  display: none;
}

.row-dot {
  position: absolute;
  left: 50%;
  margin-left: -10rpx;
  top: 30rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #fbfcf3;
  border: 5rpx solid #c6d3b2;
  z-index: 2;
}

.row-body {
  flex: 1;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx 18rpx;
}

.row-body:active {
  background: #f8fbee;
}

.row-main {
  display: flex;
  align-items: flex-start;
}

.row-title {
  flex: 1;
  font-size: 31rpx;
  line-height: 1.45;
  color: #33422d;
  word-break: break-all;
  padding-right: 16rpx;
}

.row-check {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 2rpx solid #cfdcbb;
  background: #fbfcf3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-progress {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: #f1f5e6;
  font-size: 24rpx;
  line-height: 1.6;
  color: #62705a;
  word-break: break-all;
}

/* 进度判定出来的状态 */
.st-blocked { background: #f7ecdd; color: #b06a45; }
.st-almost { background: #e6f2e4; color: #4f7a52; }
.st-half { background: #e4edf6; color: #4a6f96; }
.st-started { background: #e9eef5; color: #5b7089; }
.st-notStarted { background: #eef1e5; color: #7d8a72; }
.st-finished { background: #e6f2e4; color: #4f7a52; }
.st-doing { background: #efe9f6; color: #6f5595; }

.row-check.is-checked {
  background: #6f9461;
  border-color: #6f9461;
}

.row-tick {
  color: #fbfcf3;
  font-size: 24rpx;
  line-height: 1;
}

.row-tags {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.tag-late {
  background: #f7ecdd;
  color: #b06a45;
}

/* 已完成 / 已过点 */

.row-done .row-clock {
  color: #a9b69d;
}

.row-done .row-title {
  color: #a4b199;
  text-decoration: line-through;
}

.row-done .row-dot {
  border-color: #8fb07a;
  background: #eef5e6;
}

.row-done .row-body {
  background: #f7f9f0;
  box-shadow: none;
}

.row-late .row-dot {
  border-color: #c07a5a;
  background: #f7ecdd;
}

.row-late .row-clock {
  color: #7a9464;
}

.row-late .row-title {
  color: #3f4d38;
}

/* ---------- 底部 ---------- */

.foot {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.foot-gap {
  margin-left: 16rpx;
}

.hint {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b3c0a6;
}

/* ---------- 编辑弹层 ---------- */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(35, 29, 22, 0.42);
  animation: fadeIn 0.18s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  box-sizing: border-box;
  padding: 16rpx 32rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #fbfcf3;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -14rpx 44rpx rgba(60, 45, 30, 0.16);
  animation: sheetUp 0.22s cubic-bezier(0.2, 0.8, 0.3, 1);
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-bar {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d9e3c9;
  margin: 0 auto 18rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #33422d;
  margin-bottom: 6rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e9efdd;
}

.field-column {
  display: block;
}

.field-label {
  flex: none;
  width: 110rpx;
  font-size: 26rpx;
  color: #8d9b82;
}

.field-label-top {
  display: block;
  width: auto;
  margin-bottom: 16rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #33422d;
}

.field-ph {
  color: #b8c4ab;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #6f9461;
  letter-spacing: 1rpx;
}

.field-arrow {
  color: #bfccab;
  font-size: 32rpx;
}

.tag-picker {
  display: flex;
  flex-wrap: wrap;
}

.prog-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.prog-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d9e3c9;
  background: #f4f7ea;
  font-size: 24rpx;
  color: #7d7263;
}

.prog-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f4f7ea;
  font-size: 27rpx;
  line-height: 1.6;
  color: #33422d;
}

.tag-opt {
  margin: 0 14rpx 14rpx 0;
  padding: 12rpx 26rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d9e3c9;
  background: #f4f7ea;
  font-size: 26rpx;
  color: #7d7263;
}

.tag-opt.is-active {
  background: #eaf1de;
  border-color: #b9c9a4;
  color: #6f9461;
  font-weight: 600;
}

.sheet-actions {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}

.sheet-actions .btn-danger {
  margin-right: 18rpx;
}
