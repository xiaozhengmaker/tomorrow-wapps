.head {
  padding: 8rpx 8rpx 30rpx;
}

.eyebrow {
  font-size: 21rpx;
  letter-spacing: 8rpx;
  color: #c7c7cc;
}

.title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.34;
  color: #0a0a0a;
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #8e8e93;
}

/* ---------- 分组 ---------- */

.group {
  padding: 6rpx 26rpx;
  margin-bottom: 22rpx;
}

.group-title {
  padding: 20rpx 0 6rpx;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #c7c7cc;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ebebf0;
}

.group .row:last-child {
  border-bottom: 0;
}

.row-main {
  flex: 1;
  padding-right: 20rpx;
}

.row-title {
  display: block;
  font-size: 29rpx;
  color: #111111;
}

.row-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #aeaeb2;
}

.row-link {
  justify-content: space-between;
}

.row-value {
  flex: none;
  font-size: 28rpx;
  color: #0a84ff;
}

.is-off .row-title,
.is-off .row-value {
  color: #d8d8dd;
}

.note {
  padding: 4rpx 0 18rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #8e8e93;
}

.note.small {
  font-size: 22rpx;
  color: #aeaeb2;
  padding-bottom: 22rpx;
}

.about {
  margin-top: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #d8d8dd;
}
