.head {
  padding: 8rpx 8rpx 30rpx;
}

.eyebrow {
  font-size: 21rpx;
  letter-spacing: 8rpx;
  color: #a9b79b;
}

.title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.34;
  color: #2b3a26;
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #7d8a72;
}

/* ---------- 分组 ---------- */

.group {
  padding: 6rpx 26rpx;
  margin-bottom: 22rpx;
}

.group-title {
  padding: 20rpx 0 6rpx;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #a9b79b;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e9efdd;
}

.group .row:last-child {
  border-bottom: 0;
}

.row-main {
  flex: 1;
  padding-right: 20rpx;
}

.row-title {
  display: block;
  font-size: 29rpx;
  color: #33422d;
}

.row-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94a189;
}

.row-link {
  justify-content: space-between;
}

.row-value {
  flex: none;
  font-size: 28rpx;
  color: #6f9461;
}

.is-off .row-title,
.is-off .row-value {
  color: #bcc8b0;
}

.note {
  padding: 4rpx 0 18rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #7d8a72;
}

.note.small {
  font-size: 22rpx;
  color: #94a189;
  padding-bottom: 22rpx;
}

.about {
  margin-top: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #bcc8b0;
}
