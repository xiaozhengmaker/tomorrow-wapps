.head {
  padding: 8rpx 8rpx 30rpx;
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #a0a0a0;
}

.gear {
  color: #1e7bf5;
  font-size: 24rpx;
}

.eyebrow {
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: #c2c2c2;
}

.title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.32;
  color: #0e0e0e;
}

.sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #808080;
}

/* ---------- 完成率 ---------- */

.stat {
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 22rpx;
}

.stat-num {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  color: #1a1a1a;
  letter-spacing: -2rpx;
}

.stat-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: #8f8f8f;
  margin-left: 6rpx;
}

.stat-bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: #efefea;
  margin: 18rpx 0 14rpx;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #3d93ff, #0b5fd0);
  transition: width 0.3s ease;
}

.stat-hint {
  font-size: 22rpx;
  color: #bdbdbd;
}

/* ---------- 输入 ---------- */

.input-card {
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.label {
  font-size: 26rpx;
  color: #808080;
  margin-bottom: 14rpx;
}

.input-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f2f2ef;
  font-size: 29rpx;
  line-height: 1.7;
  color: #1a1a1a;
}

.input-ph {
  color: #cfcfcf;
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.score-label {
  font-size: 25rpx;
  color: #808080;
}

.stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 34rpx;
  color: #e0e0db;
  padding: 0 6rpx;
  line-height: 1;
}

.star.is-on {
  color: #0b5fd0;
}

/* ---------- 评估结果 ---------- */

.result {
  margin-top: 24rpx;
  padding: 26rpx;
}

.result-title {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #c2c2c2;
  margin-bottom: 16rpx;
}

.line {
  font-size: 28rpx;
  line-height: 1.85;
  color: #333333;
  padding: 6rpx 0;
  border-bottom: 1rpx dashed #ededE8;
}

.line:last-child {
  border-bottom: 0;
}

/* ---------- 同步日记 ---------- */

.sync {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  margin-top: 22rpx;
  background: #f2f2ef;
}

.sync:active {
  background: #eaeae5;
}

.sync-main {
  flex: 1;
}

.sync-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.sync-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9e9e9e;
}

.sync-arrow {
  flex: none;
  font-size: 32rpx;
  color: #d8d8d3;
}

/* ---------- 趋势 ---------- */

.trend {
  padding: 24rpx 26rpx 18rpx;
  margin-top: 24rpx;
}

.trend-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.trend-title {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #c2c2c2;
}

.trend-avg {
  font-size: 24rpx;
  color: #3d93ff;
}

.bars {
  display: flex;
  align-items: flex-end;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-track {
  height: 120rpx;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 26rpx;
  border-radius: 6rpx;
  background: #eaeae5;
}

.bar.is-on {
  background: linear-gradient(180deg, #3d93ff 0%, #0b5fd0 100%);
}

.bar-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #9e9e9e;
}

/* ---------- 历史 ---------- */

.history {
  margin-top: 36rpx;
}

.history-title {
  padding-left: 6rpx;
  margin-bottom: 14rpx;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #c2c2c2;
}

.hist {
  padding: 20rpx 26rpx;
  margin-bottom: 14rpx;
}

.hist-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hist-date {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.hist-rate {
  font-size: 24rpx;
  color: #3d93ff;
}

.hist-ex {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #808080;
}
