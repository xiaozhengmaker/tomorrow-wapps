.head {
  padding: 8rpx 8rpx 30rpx;
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #aeaeb2;
}

.gear {
  color: #0a84ff;
  font-size: 24rpx;
}

.eyebrow {
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: #c7c7cc;
}

.title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.32;
  color: #0a0a0a;
}

.sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8e8e93;
}

/* ---------- 完成率 ---------- */

.stat {
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 22rpx;
}

.stat-num {
  font-size: 104rpx;
  font-weight: 700;
  line-height: 1;
  color: #111111;
  letter-spacing: -2rpx;
}

.stat-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: #8e8e93;
  margin-left: 6rpx;
}

.stat-bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: #f2f2f7;
  margin: 18rpx 0 14rpx;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #3395ff, #0060df);
  transition: width 0.3s ease;
}

.stat-hint {
  font-size: 22rpx;
  color: #c7c7cc;
}

/* ---------- 输入 ---------- */

.input-card {
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.label {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 14rpx;
}

.input-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  font-size: 29rpx;
  line-height: 1.7;
  color: #111111;
}

.input-ph {
  color: #c9c9c9;
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.score-label {
  font-size: 25rpx;
  color: #8e8e93;
}

.stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 34rpx;
  color: #e5e5ea;
  padding: 0 6rpx;
  line-height: 1;
}

.star.is-on {
  color: #0060df;
}

/* ---------- 评估结果 ---------- */

.result {
  margin-top: 24rpx;
  padding: 26rpx;
}

.result-title {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #c7c7cc;
  margin-bottom: 16rpx;
}

.line {
  font-size: 28rpx;
  line-height: 1.85;
  color: #2c2c2e;
  padding: 6rpx 0;
  border-bottom: 1rpx dashed #eeeef2;
}

.line:last-child {
  border-bottom: 0;
}

/* ---------- 同步日记 ---------- */

.sync {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  margin-top: 22rpx;
  background: #f2f2f7;
}

.sync:active {
  background: #e5e5ea;
}

.sync-main {
  flex: 1;
}

.sync-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.sync-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #aeaeb2;
}

.sync-arrow {
  flex: none;
  font-size: 32rpx;
  color: #d8d8dd;
}

/* ---------- 趋势 ---------- */

.trend {
  padding: 24rpx 26rpx 18rpx;
  margin-top: 20rpx;
  background: #fbfdff;
  border-color: #eaf3ff;
}

.trend-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.trend-title {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #c7c7cc;
}

.trend-avg {
  font-size: 24rpx;
  color: #3395ff;
}

.bars {
  display: flex;
  align-items: flex-end;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-track {
  height: 120rpx;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 26rpx;
  border-radius: 6rpx;
  background: #e5e5ea;
}

.bar.is-on {
  background: linear-gradient(180deg, #3395ff 0%, #0060df 100%);
}

.bar-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #aeaeb2;
}

/* ---------- 历史 ---------- */

.history {
  margin-top: 36rpx;
}

.history-title {
  padding-left: 6rpx;
  margin-bottom: 14rpx;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #c7c7cc;
}

.hist {
  padding: 20rpx 26rpx;
  margin-bottom: 14rpx;
}

.hist-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hist-date {
  font-size: 26rpx;
  color: #111111;
  font-weight: 600;
}

.hist-rate {
  font-size: 24rpx;
  color: #3395ff;
}

.hist-ex {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8e8e93;
}

/* 完成率卡：让它成为页面的视觉锚点 */
.card-tint-blue {
  background: linear-gradient(150deg, #e8f4ff 0%, #f7fbff 55%, #ffffff 100%) !important;
  border-color: #d6eaff !important;
  box-shadow: 0 14rpx 34rpx rgba(10, 132, 255, 0.10);
}

.trend .bar.is-on {
  background: linear-gradient(180deg, #5aa5ff 0%, #0a84ff 100%);
}