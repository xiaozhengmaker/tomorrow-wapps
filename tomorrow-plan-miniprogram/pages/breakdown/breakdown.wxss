.head {
  padding: 8rpx 8rpx 30rpx;
}

.eyebrow {
  font-size: 21rpx;
  letter-spacing: 8rpx;
  color: #c2c2c2;
}

.title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.34;
  color: #0e0e0e;
}

.sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #808080;
}

/* ---------- 输入 ---------- */

.input-card {
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.input-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f2f2ef;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a1a;
}

.input-ph {
  color: #cfcfcf;
}

.input-card .btn-primary {
  margin-top: 20rpx;
  height: 84rpx;
}

/* ---------- 结果卡 ---------- */

.result {
  padding: 26rpx 26rpx 20rpx;
  margin-bottom: 22rpx;
}

.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.result-goal {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding-right: 14rpx;
}

.result-badge {
  flex: none;
  font-size: 20rpx;
  color: #1e7bf5;
  background: #e6f0ff;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
}

.result-badge.is-busy {
  background: #f0f0ec;
  color: #8f8f8f;
}

.step {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-top: 1rpx dashed #e8e8e3;
}

.step-no {
  flex: none;
  width: 44rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #c4c4c4;
  padding-top: 6rpx;
}

.step-main {
  flex: 1;
  min-width: 0;
}

.step-text {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  color: #1a1a1a;
}

.step-ph {
  color: #d4d4d4;
}

.step-min {
  display: inline-block;
  margin-top: 8rpx;
  padding: 3rpx 14rpx;
  border-radius: 20rpx;
  background: #f0f0ec;
  font-size: 22rpx;
  color: #808080;
}

.step-del {
  flex: none;
  width: 48rpx;
  padding-top: 6rpx;
  text-align: center;
  font-size: 24rpx;
  color: #d8d8d3;
}

.step-add {
  padding: 16rpx 0 4rpx 44rpx;
  font-size: 25rpx;
  color: #1e7bf5;
}

.result-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e8e8e3;
}

.total {
  font-size: 24rpx;
  color: #8f8f8f;
}

.acts {
  display: flex;
  align-items: center;
}

.acts .btn-ghost,
.acts .btn-primary {
  margin-left: 12rpx;
}

/* ---------- 历史 ---------- */

.history {
  margin-top: 36rpx;
}

.history-title {
  padding-left: 6rpx;
  margin-bottom: 14rpx;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #c2c2c2;
}

.hist {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  margin-bottom: 14rpx;
}

.hist-main {
  flex: 1;
  min-width: 0;
}

.hist-goal {
  display: block;
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hist-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9e9e9e;
}

.hist-arrow {
  flex: none;
  font-size: 32rpx;
  color: #d8d8d3;
}

.history-tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 21rpx;
  color: #d8d8d8;
}
